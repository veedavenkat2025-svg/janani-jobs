// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id           String    @id @default(cuid())
  title        String
  organization String
  type         String    // 'GOVERNMENT' or 'PRIVATE'
  category     String    @default("NEW_UPDATE") // 'NEW_UPDATE', 'ADMIT_CARD', 'RESULT'
  location     String?
  state        String?   // Indian State or 'Central' for All-India
  description  String
  applyUrl     String
  sourceUrl    String?   // Link to the official govt website it was scraped from
  salary       String?
  qualification String?  // e.g., '10th Pass', '12th Pass', 'Graduation'
  deadline     DateTime?
  postedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  savedBy      SavedJob[]

  @@index([type])
  @@index([postedAt(sort: Desc)])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// --- NextAuth Models ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  qualification String?   // e.g., '10th Pass', '12th Pass', 'Graduation'
  role          String    @default("USER") // 'USER' or 'ADMIN'
  jobPreference String    @default("ALL")  // 'ALL', 'GOVERNMENT', 'PRIVATE'
  statePreference String? // e.g., 'Telangana', 'All India'
  accounts      Account[]
  sessions      Session[]
  savedJobs     SavedJob[]
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

